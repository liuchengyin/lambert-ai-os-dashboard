# AI 接班工作室运行环境模板（不含密钥，禁止提交真实值）
# 真实文件放服务器 /etc/lambert-studio/runtime.env，root:lambert-studio 0640。
# 只复用现有 Supabase 项目的公共配置，绝不填 service_role、数据库密码或用户凭据。
LAMBERT_PUBLIC_SITE_URL=https://YOUR_HOST
LAMBERT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
LAMBERT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# 逗号分隔的 Supabase 用户 UUID；留空=拒绝所有访问（安全默认）。
STUDIO_ALLOWED_USER_IDS=
# DeepSeek 主模型；密钥由操作者经 stdin 写入，不进入聊天/日志/仓库。
DEEPSEEK_API_KEY=
# GLM 备用；本阶段不要求接通，可留空。
ZHIPU_API_KEY=
# 草稿 PR 用；无令牌时任务停在 create_pr 游标，可后续补配置。
STUDIO_GITHUB_TOKEN=
STUDIO_PR_BASE=main
STUDIO_PORT=3001
STUDIO_STATE_DIR=/var/lib/lambert-studio
STUDIO_REPO_DIR=/opt/lambert-studio-repo
STUDIO_POLICY_FILE=/etc/lambert-studio/policy.json
