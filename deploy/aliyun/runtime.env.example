# Copy to /home/admin/lambert-deploy/config/runtime.env (directory 700, file 600).
# The publishable key is public client configuration; never put service_role here.
NODE_ENV=production
PORT=3000
AI_ENABLED=false
LAMBERT_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
LAMBERT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
LAMBERT_PUBLIC_SITE_URL=https://YOUR_PUBLIC_IP_OR_DOMAIN
# SHA-256 hex of the password required to enter the embedded "常用链接" view.
# Generate locally: printf '%s' 'YOUR_PASSWORD' | shasum -a 256 | cut -d' ' -f1
LINKS_VIEW_PASSWORD_HASH=
