{
  "buildCommand": "python3 scripts/build-web-update.py",
  "outputDirectory": ".",
  "headers": [
    {"source": "/mobile/updates/latest.json", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/mobile/updates/(.*).zip", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ]
}
